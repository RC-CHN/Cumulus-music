{
  "name": "@cumulus/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src tests public index.html",
    "format:check": "prettier --check src tests public index.html",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test tests/*.test.ts",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "cd ../desktop && tauri dev",
    "desktop:build": "cd ../desktop && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
